# RackMind AI configuration
# Copy this file to .env and fill in the values you need.

# Provider selection: auto | gemini | openai | claude
# auto prefers OpenAI, then Claude, then Gemini, based on which key is set.
AI_PROVIDER=auto

# Google Gemini (key from Google AI Studio, usually starts with "AIza")
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (key usually starts with "sk-")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Anthropic Claude (key usually starts with "sk-ant-")
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Maximum size (MB) accepted for uploaded logs and sensor CSVs
MAX_UPLOAD_MB=20

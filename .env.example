# RackMind AI configuration
# Copy this file to .env and fill in the values you need.

# Provider selection: auto | gemini | openai
# auto prefers OpenAI when OPENAI_API_KEY is set, otherwise falls back to Gemini.
AI_PROVIDER=auto

# Google Gemini (key from Google AI Studio, usually starts with "AIza")
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (key usually starts with "sk-")
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

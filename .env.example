AI_PROVIDER=auto
OPENAI_MODEL=gpt-5.5
GEMINI_MODEL=gemini-2.5-flash

# Optional UI authentication. Values are JSON: username -> SHA-256(password), or
# {"password_sha256":"...","role":"admin|operator|viewer"}.
# Generate a hash with: python -c "import hashlib; print(hashlib.sha256(b'change-me').hexdigest())"
RACKMIND_USERS={"operator":"replace-with-sha256"}
